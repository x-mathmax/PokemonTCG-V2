    {
      "parameters": {
        "jsCode": "const webhookData = $('Webhook Reporte').first().json.body;\nconst cards = $input.all().map(item => item.json);\nconst summary = webhookData.summary;\n\nconst rows = cards.map(c => `\n  <tr>\n    <td style=\"padding:8px;border-bottom:1px solid #ddd;\"><strong>${c.name}</strong></td>\n    <td style=\"padding:8px;border-bottom:1px solid #ddd;\">${c.set_name}</td>\n    <td style=\"padding:8px;border-bottom:1px solid #ddd;\">${c.rarity}</td>\n    <td style=\"padding:8px;border-bottom:1px solid #ddd;\">$${Number(c.estimated_price).toFixed(2)}</td>\n  </tr>\n`).join('');\n\nconst html = `\n  <div style=\"font-family:Arial,sans-serif;max-width:600px;margin:auto;border:2px solid #134074;border-radius:12px;overflow:hidden;\">\n    <div style=\"background:#0B2545;color:#FFCB05;padding:16px;text-align:center;\">\n      <h2 style=\"margin:0;\">Reporte de Inventario Pokémon TCG</h2>\n    </div>\n    <div style=\"padding:20px;\">\n      <p><strong>Total de cartas:</strong> ${summary.total_cards}</p>\n      <p><strong>Valuación Total:</strong> $${Number(summary.total_valuation_usd).toFixed(2)} USD</p>\n      <p><strong>Carta más valiosa:</strong> ${summary.most_expensive_card?.name || 'N/A'} ($${summary.most_expensive_card?.estimated_price || 0})</p>\n      <table style=\"width:100%;border-collapse:collapse;margin-top:16px;\">\n        <thead>\n          <tr style=\"background:#F0F4F8;text-align:left;\">\n            <th style=\"padding:8px;\">Carta</th>\n            <th style=\"padding:8px;\">Set</th>\n            <th style=\"padding:8px;\">Rareza</th>\n            <th style=\"padding:8px;\">Precio</th>\n          </tr>\n        </thead>\n        <tbody>${rows}</tbody>\n      </table>\n    </div>\n  </div>\n`;\n\nreturn [{ json: { to: webhookData.destination_email, subject: `Reporte TCG Vault - Valuación Total: $${summary.total_valuation_usd} USD`, html } }];"
      },
      "id": "8f888c1f-1f98-4068-ba2d-fdf99f3ea35e",
